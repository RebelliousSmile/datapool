{
  "name": "datapool",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Interface de visualisation des pools et du corpus de webpool, via son API HTTP.",
  "type": "module",
  "private": true,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy:prod": "node scripts/deploy.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "api:types": "openapi-typescript ../webpool/openapi.json -o src/lib/api/schema.d.ts",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^22.17.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
